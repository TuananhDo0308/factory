{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "blockers", "minorNotes"],
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "file", "problem", "fix"],
        "properties": {
          "category": { "type": "string", "enum": ["bug", "test-gap", "security", "bloat", "contract"] },
          "file": { "type": "string" },
          "problem": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "minorNotes": { "type": "array", "items": { "type": "string" } }
  }
}
