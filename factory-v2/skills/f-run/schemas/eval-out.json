{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "scores", "visualCritique", "criteria"],
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designQuality", "originality", "craft", "functionality"],
      "properties": {
        "designQuality": { "type": "integer", "minimum": 1, "maximum": 5 },
        "originality": { "type": "integer", "minimum": 1, "maximum": 5 },
        "craft": { "type": "integer", "minimum": 1, "maximum": 5 },
        "functionality": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "visualCritique": { "type": "string" },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["met", "not_met"] },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
