{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory v2 Parallel Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tracks"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "baseBranch": { "type": "string", "default": "main" },
    "hasUi": { "type": "boolean", "default": false },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "wave", "owns"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "wave": { "type": "integer", "minimum": 0 },
          "size": { "type": "string", "enum": ["S", "M", "L"] },
          "kind": { "type": "string", "enum": ["foundation", "feature", "bug", "wiring", "tests", "refactor"] },
          "objective": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "owns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "allowProtected": { "type": "array", "items": { "type": "string" } },
          "contracts": { "type": "array", "items": { "type": "string" } },
          "criteria": { "type": "array", "items": { "type": "string" } },
          "prototypeFile": { "type": "string" },
          "skipReview": { "type": "boolean" }
        }
      }
    }
  }
}
