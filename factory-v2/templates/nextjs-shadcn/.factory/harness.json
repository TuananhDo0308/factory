{
  "schemaVersion": 2,
  "stack": "nextjs-shadcn",
  "hasUi": true,
  "commands": {
    "lintChanged": "npx eslint --max-warnings 0 {files}",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "testFiles": "npx vitest run {files}",
    "test": "npm test",
    "build": "npm run build",
    "start": "npm run start",
    "dev": "npm run dev"
  },
  "exemplars": [
    "src/components/exemplar-card.tsx",
    "src/components/exemplar-card.test.tsx"
  ],
  "protectedPaths": [
    "src/components/ui/**",
    "src/test/setup.ts"
  ],
  "antiBloat": {
    "maxComponentLines": 350,
    "maxSourceLines": 450,
    "maxTestLines": 500,
    "maxTestToProdRatio": 2.2,
    "minProdLinesForRatio": 120
  }
}
