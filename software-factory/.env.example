# Database (PostgreSQL via Prisma 7 + @prisma/adapter-pg)
DATABASE_URL="postgresql://user:password@localhost:5432/software_factory?schema=public"
# Optional direct / unpooled connection URL for Prisma CLI migrations & db push
# DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/software_factory?schema=public"
# Vercel Postgres aliases also supported: POSTGRES_PRISMA_URL, POSTGRES_URL, POSTGRES_URL_NON_POOLING

# Public application URL
APP_PUBLIC_URL="http://localhost:8787"
NEXT_PUBLIC_APP_URL="http://localhost:8787"
# Sharing `next dev` on a LAN: set the two URLs above to http://<your LAN IP>:8787 and list that
# host here (comma-separated) so other machines can load the dev server's assets.
# SF_ALLOWED_DEV_ORIGINS="192.168.1.20"
# Optional fallback public URL alias
# PUBLIC_URL="http://localhost:8787"

# Authentication & sessions
SF_REQUIRE_OAUTH="false"
SESSION_SECRET="replace-with-a-32-byte-random-hex-secret"
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
# Optional GitHub API base for repository tracking (GitHub Enterprise); defaults to https://api.github.com
# GITHUB_API_URL="https://github.example.com/api/v3"

# Factory runner & bot integration
FACTORY_BOT_GITHUB_USERNAME="your_ai_server_github_username"
# Optional dedicated GitHub PAT for auto-accepting collaborator invites
# FACTORY_BOT_GITHUB_TOKEN=""
FACTORY_WORKSPACES_DIR="/path/to/software-factory-workspaces"
SF_SKILLS_REPO_URL="https://github.com/All-Chat-Bridge-for-CRM/ConverReplay"
# Optional CLI overrides (used by cli/sf.ts)
# SF_SKILLS_REPO=""
# SF_HOME="$HOME/.software-factory"
# SF_PROJECTS_DIR=""
# SF_SERVER_URL="http://localhost:8787"
# SF_URL="http://localhost:8787"
# SF_TOKEN=""
